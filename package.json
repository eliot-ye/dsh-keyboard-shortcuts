{
  "name": "dsh-keyboard-shortcuts",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Global keyboard shortcuts: focus the composer and switch to the 1st-9th sidebar session, with a numbered hint badge while the modifier is held.",
  "author": "Eliot <eliot_ye@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliot-ye/dsh-keyboard-shortcuts.git"
  },
  "bugs": {
    "url": "https://github.com/eliot-ye/dsh-keyboard-shortcuts/issues"
  },
  "homepage": "https://github.com/eliot-ye/dsh-keyboard-shortcuts#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "keyboard-shortcuts",
    "plugin",
    "shortcut"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
